POSTGRES_USER=myuser
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=mystockdb
POSTGRES_INITDB_ARGS=--encoding=UTF-8 --no-locale

# for batch/ running outside docker compose (e.g. `python batch/main.py ...` on the host)
DB_HOST=localhost
DB_PORT=5432

JQUANTS_API_KEY=
JQUANTS_BASE_URL=https://api.jquants.com